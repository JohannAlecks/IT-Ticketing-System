generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  INTERNET_NETWORK
  VPN
  PC_LAPTOP
  PRINTER_SCANNER
  ACCOUNTS_ACCESS
  EMAIL
  SOFTWARE_APPLICATION
  SERVER_SYSTEM
  REQUESTS
  SECURITY
  OTHERS
}

enum ActivityAction {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  UPDATED
  CLOSED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  TICKET_ARCHIVED
  TICKET_RESTORED
}

enum KnowledgeArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeVisibility {
  PUBLIC
  INTERNAL
}

enum NotificationType {
  TICKET_WATCHED_UPDATE
  TICKET_SATISFACTION_RECEIVED
  TICKET_ASSIGNED
  TICKET_UNASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_PUBLIC_REPLY
  TICKET_WORK_BLOCKING
  KNOWLEDGE_SUBMITTED
  KNOWLEDGE_PUBLISHED
  KNOWLEDGE_RETURNED
  ACCOUNT_REACTIVATED
  SLA_FIRST_RESPONSE_DUE_SOON
  SLA_FIRST_RESPONSE_BREACHED
  SLA_RESOLUTION_DUE_SOON
  SLA_RESOLUTION_BREACHED
}

enum PendingReason {
  WAITING_FOR_REQUESTER
  OTHER
}

enum SavedViewScope {
  MY_TICKETS
  ASSIGNED_TO_ME
  ALL_AUTHORIZED
  ARCHIVED
}

enum ShortcutTargetType {
  ROUTE
  SAVED_VIEW
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id               String      @id @default(uuid())
  name             String
  email            String      @unique
  password         String
  role             Role        @default(USER)
  isActive         Boolean     @default(true)
  // Defaults to true so this migration doesn't lock out existing/seeded
  // accounts that were created before email verification existed.
  // auth.service.js explicitly sets this to false for brand-new
  // registrations going through the public /auth/register endpoint.
  emailVerified    Boolean     @default(true)
  department       String?
  departmentId     String?
  departmentRecord Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  ticketsCreated            Ticket[]                 @relation("TicketCreatedBy")
  ticketsAssigned           Ticket[]                 @relation("TicketAssignedTo")
  ticketsArchived           Ticket[]                 @relation("TicketArchivedBy")
  comments                  Comment[]
  activities                TicketHistory[]
  attachments               TicketAttachment[]
  verificationTokens        EmailVerificationToken[]
  auditEvents               AuditEvent[]
  onboarding                UserOnboarding?
  knowledgeArticlesAuthored KnowledgeArticle[]       @relation("KnowledgeArticleAuthor")
  knowledgeArticlesReviewed KnowledgeArticle[]       @relation("KnowledgeArticleReviewer")
  articleFeedback           ArticleFeedback[]        @relation("ArticleFeedbackUser")
  notificationsReceived     Notification[]           @relation("NotificationRecipient")
  notificationsActed        Notification[]           @relation("NotificationActor")
  notificationPreference    NotificationPreference?
  resolutionRequests        TicketResolutionCycle[]  @relation("ResolutionRequester")
  resolutionAssignments     TicketResolutionCycle[]  @relation("ResolutionAgent")
  satisfactions             TicketSatisfaction[]
  savedTicketViews          SavedTicketView[]
  shortcuts                 UserShortcut[]
  ticketWatches             TicketWatcher[]

  @@index([email])
  @@index([role])
  @@index([departmentId, isActive, role])
  @@map("users")
}

enum EmailLogStatus {
  DISABLED
  UNKNOWN
  ACCEPTED
  FAILED
}

enum EmailLogProvider {
  DISABLED
  RESEND
}

enum EmailLogType {
  EMAIL_VERIFICATION
}

enum EmailLogError {
  EMAIL_DISABLED
  NOT_CONFIRMED
  PROVIDER_REJECTED
  TIMEOUT
  TRANSPORT_ERROR
  INVALID_RESPONSE
}

model EmailLog {
  id                String           @id @default(uuid())
  messageType       EmailLogType
  recipientMasked   String           @db.VarChar(20)
  provider          EmailLogProvider
  status            EmailLogStatus
  idempotencyHash   String           @unique @db.VarChar(64)
  providerMessageId String?          @db.Uuid
  attemptCount      Int              @default(0)
  errorCategory     EmailLogError?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  acceptedAt        DateTime?
  failedAt          DateTime?

  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@map("email_logs")
}

model Department {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  normalizedName String   @unique @db.VarChar(100)
  description    String?  @db.VarChar(500)
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]

  @@index([isActive, name, id])
  @@map("departments")
}

model TicketWatcher {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
  @@index([userId, createdAt])
  @@map("ticket_watchers")
}

model SavedTicketView {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String         @db.VarChar(60)
  normalizedName String         @db.VarChar(120)
  scope          SavedViewScope
  filters        Json
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  shortcuts      UserShortcut[]

  @@unique([userId, normalizedName])
  @@unique([userId, id])
  @@map("saved_ticket_views")
}

model UserShortcut {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String             @db.VarChar(40)
  targetType  ShortcutTargetType
  routeKey    String?            @db.VarChar(40)
  savedViewId String?
  savedView   SavedTicketView?   @relation(fields: [userId, savedViewId], references: [userId, id], onDelete: Cascade)
  targetKey   String             @db.VarChar(80)
  position    Int
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, targetKey])
  @@unique([userId, position])
  @@index([userId, savedViewId])
  @@map("user_shortcuts")
}

// In-app inbox rows deliberately keep resource references as scalar IDs. This
// preserves an auditable notification after a ticket/article is removed and
// avoids storing user-controlled navigation URLs or source content.
model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  ticketId    String?
  articleId   String?
  title       String           @db.VarChar(160)
  message     String           @db.VarChar(300)
  dedupeKey   String?          @unique @db.VarChar(255)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

// Per-user in-app notification settings. Missing rows deliberately mean every
// optional notification remains enabled, so introducing preferences never
// changes the delivery behavior for existing accounts.
model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketAssigned       Boolean  @default(true)
  ticketUnassigned     Boolean  @default(true)
  ticketStatusChanged  Boolean  @default(true)
  ticketPublicReply    Boolean  @default(true)
  ticketWatchedUpdates Boolean  @default(true)
  ticketWorkBlocking   Boolean  @default(true)
  knowledgeSubmitted   Boolean  @default(true)
  knowledgePublished   Boolean  @default(true)
  knowledgeReturned    Boolean  @default(true)
  slaDueSoon           Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("notification_preferences")
}

model UserOnboarding {
  id             String    @id @default(cuid())
  userId         String    @unique
  completedSteps Json      @default("[]")
  dismissedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_onboarding")
}

// Security and business audit trail. It intentionally stores metadata, never
// passwords, tokens, authorization headers, comment bodies, or file contents.
model AuditEvent {
  id          String   @id @default(uuid())
  eventType   String
  entityType  String
  entityId    String
  requestId   String?
  metadata    Json?
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_events")
}

model Ticket {
  watchers          TicketWatcher[]
  id                String          @id @default(uuid())
  title             String
  description       String          @db.Text
  status            TicketStatus    @default(OPEN)
  priority          TicketPriority  @default(MEDIUM)
  category          TicketCategory  @default(OTHERS)
  isWorkBlocking    Boolean         @default(false)
  impactDescription String?         @db.VarChar(500)

  createdById String
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("TicketArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  // SLA is intentionally a per-ticket snapshot: pre-migration tickets stay
  // null, and later policy edits cannot rewrite historic targets.
  slaPolicyId                  String?
  slaPolicyName                String?
  slaFirstResponseMinutes      Int?
  slaResolutionMinutes         Int?
  slaDueSoonMinutes            Int?
  firstResponseDueAt           DateTime?
  firstResponseDueSoonAt       DateTime?
  firstRespondedAt             DateTime?
  firstResponseBreachedAt      DateTime?
  resolutionCycleStartedAt     DateTime?
  resolutionDueAt              DateTime?
  resolutionDueSoonAt          DateTime?
  resolutionCompletedAt        DateTime?
  resolutionBreachedAt         DateTime?
  resolutionPausedAt           DateTime?
  resolutionPausedSeconds      Int                     @default(0)
  resolutionPausedMilliseconds Float                   @default(0)
  slaVersion                   Int                     @default(0)
  pendingReason                PendingReason?
  satisfactionCycleNumber      Int                     @default(0)
  resolutionCycles             TicketResolutionCycle[]

  comments    Comment[]
  history     TicketHistory[]
  attachments TicketAttachment[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdById])
  @@index([assignedToId])
  @@index([archivedAt])
  @@index([status, priority])
  @@index([createdAt])
  @@index([archivedAt, status, firstResponseDueAt])
  @@index([archivedAt, status, resolutionDueAt])
  @@index([archivedAt, status, resolutionPausedAt])
  @@map("tickets")
}

model SlaPolicy {
  id                   String         @id @default(uuid())
  name                 String         @db.VarChar(100)
  priority             TicketPriority @unique
  firstResponseMinutes Int
  resolutionMinutes    Int
  dueSoonMinutes       Int
  isActive             Boolean        @default(true)
  version              Int            @default(1)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("sla_policies")
}

// Immutable completion snapshots also cover tickets without an SLA. Existing
// completed tickets deliberately receive no fabricated completion cycle.
model TicketResolutionCycle {
  id                 String              @id @default(uuid())
  ticketId           String
  ticket             Ticket              @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  number             Int
  requesterId        String
  requester          User                @relation("ResolutionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedAgentId    String?
  assignedAgent      User?               @relation("ResolutionAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  departmentSnapshot String?             @db.VarChar(100)
  resolvedAt         DateTime
  satisfaction       TicketSatisfaction?

  @@unique([ticketId, number])
  @@index([requesterId, resolvedAt])
  @@index([assignedAgentId, resolvedAt])
  @@map("ticket_resolution_cycles")
}

model TicketSatisfaction {
  id          String                @id @default(uuid())
  cycleId     String                @unique
  cycle       TicketResolutionCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  requesterId String
  requester   User                  @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  rating      Int
  comment     String?               @db.VarChar(1000)
  version     Int                   @default(1)
  submittedAt DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([requesterId, submittedAt])
  @@index([submittedAt])
  @@map("ticket_satisfactions")
}

model Comment {
  id         String  @id @default(uuid())
  content    String  @db.Text
  isInternal Boolean @default(false)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([authorId])
  @@map("comments")
}

model TicketHistory {
  id     String         @id @default(uuid())
  action ActivityAction @default(CREATED)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // SLA sweeps are automated events and therefore have no human actor.
  // SetNull retains history if an account is later removed.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  description String
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("ticket_history")
}

// Files are stored on local disk under server/uploads/ (see upload.js
// middleware), NOT in the database — only metadata + the relative storage
// path live here. storagePath is never served as a raw static path; every
// read goes through the authenticated, ticket-authorization-checked
// download route in attachment.service.js.
model TicketAttachment {
  id               String @id @default(uuid())
  originalFileName String
  storagePath      String // relative path under the uploads root, not web-exposed directly
  mimeType         String
  fileSize         Int // bytes

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([uploadedById])
  @@map("ticket_attachments")
}

// Verification tokens are stored as SHA-256 HASHES, never the raw token —
// the raw token only ever exists in the email link and in memory during
// generation/verification. A leaked database dump can't be used to forge
// verified accounts. A fresh row is created on register/resend; the
// previous unused row for that user is deleted at that point (see
// auth.service.js), so at most one active token exists per user.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime? // set once, then the token can never verify again

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model KnowledgeArticle {
  id             String                 @id @default(uuid())
  title          String                 @db.VarChar(150)
  slug           String                 @unique @db.VarChar(180)
  summary        String                 @db.VarChar(300)
  content        String                 @db.Text
  status         KnowledgeArticleStatus @default(DRAFT)
  visibility     KnowledgeVisibility    @default(INTERNAL)
  ticketCategory TicketCategory         @default(OTHERS)
  tags           String[]               @default([])
  reviewNote     String?                @db.VarChar(1000)
  version        Int                    @default(1)

  authorId     String?
  author       User?   @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?   @relation("KnowledgeArticleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  feedback ArticleFeedback[] @relation("KnowledgeArticleFeedback")

  @@index([status, visibility, publishedAt])
  @@index([ticketCategory, status, visibility])
  @@index([authorId, status, updatedAt])
  @@map("knowledge_articles")
}

model ArticleFeedback {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation("KnowledgeArticleFeedback", fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("ArticleFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([articleId, userId])
  @@index([articleId, helpful])
  @@map("article_feedback")
}
