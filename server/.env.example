NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:password@localhost:5432/ticketing_db?schema=public"

JWT_SECRET=replace_this_with_a_long_random_string_in_production
JWT_EXPIRES_IN=1d

# Development value. In production this must be the public HTTPS URL used
# in verification links (for example, https://app.example.com).
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Set TRUST_PROXY=true only when a trusted reverse proxy sets the client IP.
TRUST_PROXY=false
LOG_FORMAT=pretty
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# Local storage is the verified development provider. S3-compatible storage
# requires a provider implementation and credentials before production use.
STORAGE_PROVIDER=local
MAX_ATTACHMENT_SIZE_MB=5
# ALLOWED_ATTACHMENT_MIME_TYPES=image/png,image/jpeg,application/pdf,text/plain

# Email verification. Keep delivery disabled for local development. Production
# must explicitly select `resend` and provide deployment-only credentials.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=HelpDesk <support@example.com>
EMAIL_REPLY_TO=
EMAIL_SUPPORT=
EMAIL_APP_NAME=HelpDesk
EMAIL_DELIVERY_TIMEOUT_MS=10000
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
